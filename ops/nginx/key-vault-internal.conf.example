# Internal HTTPS ingress for the key-vault worker on the ARM 4/24 VPS.
# Replace the hostname, certificate paths and SHOPBOT_VPS_IP before enabling.
# Keep this endpoint off the public Internet: bearer auth is defense in depth.
server {
    listen 443 ssl http2;
    server_name key-vault-internal.example.com;

    ssl_certificate     /etc/letsencrypt/live/key-vault-internal.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/key-vault-internal.example.com/privkey.pem;
    include /etc/nginx/snippets/ssl-params.conf;

    allow 127.0.0.1;
    allow <SHOPBOT_VPS_IP>;
    deny all;

    # No request URI is logged, preventing accidental query-secret capture.
    access_log off;
    client_max_body_size 64k;

    location = /internal/key-vault/lookup {
        proxy_pass http://127.0.0.1:8093;
        include /etc/nginx/snippets/proxy-params.conf;
    }

    location = /health {
        proxy_pass http://127.0.0.1:8093;
        include /etc/nginx/snippets/proxy-params.conf;
    }

    location / { return 404; }
}
