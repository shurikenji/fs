# Run this worker on the ARM 4 OCPU / 24 GB VPS, not on Shopbot.
CONTROL_PLANE_URL=http://127.0.0.1:8090
CONTROL_PLANE_TOKEN=
KEY_VAULT_API_TOKEN=
# 32 bytes, base64 encoded. Keep this outside the database and Object Storage bucket.
KEY_VAULT_MASTER_KEY=
# Shared with Shopbot; used to create an HMAC lookup fingerprint.
KEY_VAULT_LOOKUP_SECRET=
KEY_VAULT_DB_PATH=/srv/shupremium-stack/shared/key-vault-worker/data/key_vault.db
KEY_VAULT_POLL_SECONDS=600
KEY_VAULT_SNAPSHOT_RETENTION_DAYS=7
KEY_VAULT_MISSING_RETENTION_DAYS=90
