OPERATOR_PORT=8091
OPERATOR_TOKEN=
ROOT_DOMAIN=shupremium.com
WILDCARD_CERT_NAME=shupremium-wildcard
WILDCARD_CERT_DIR=/etc/letsencrypt/live/shupremium-wildcard
CLOUDFLARE_CREDENTIALS=/home/ubuntu/.secrets/cloudflare.ini
PROXY_SERVICE_PATH=/srv/shupremium-stack/current/proxy-gateway/proxy-service
NGINX_SITES_AVAILABLE=/etc/nginx/sites-available
NGINX_SITES_ENABLED=/etc/nginx/sites-enabled
OPERATOR_BIND_HOST=127.0.0.1
PROXY_BIND_HOST=127.0.0.1
OPERATOR_RUNTIME_LOCK_DIR=/srv/shupremium-stack/shared/_ops/runtime.lock
OPERATOR_BACKUP_ROOT=/srv/shupremium-stack/shared/proxy-gateway/proxy-operator/backups
OPERATOR_JOB_LOG_DIR=/srv/shupremium-stack/shared/proxy-gateway/proxy-operator/jobs
